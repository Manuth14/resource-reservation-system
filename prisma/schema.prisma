generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  role         String        @default("MEMBER") @db.VarChar(20)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  reservations Reservation[]
  @@map("users")
}

model ResourceType {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String     @unique @db.VarChar(100)
  resources Resource[]
  @@map("resource_types")
}

model Resource {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type_id      String        @db.Uuid
  name         String        @db.VarChar(150)
  location     String?       @db.VarChar(150)
  capacity     Int?
  description  String?
  is_active    Boolean       @default(true)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  type         ResourceType  @relation(fields: [type_id], references: [id])
  reservations Reservation[]
  @@map("resources")
}

// The overlap rule is an EXCLUDE constraint in PostgreSQL (see db/init.sql); Prisma cannot model it.
model Reservation {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_id  String    @db.Uuid
  user_id      String    @db.Uuid
  title        String    @db.VarChar(200)
  start_time   DateTime  @db.Timestamptz(6)
  end_time     DateTime  @db.Timestamptz(6)
  status       String    @default("CONFIRMED") @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  cancelled_at DateTime? @db.Timestamptz(6)
  resource     Resource  @relation(fields: [resource_id], references: [id])
  user         User      @relation(fields: [user_id], references: [id])
  @@index([resource_id, start_time])
  @@index([user_id])
  @@map("reservations")
}
